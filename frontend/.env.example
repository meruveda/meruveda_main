# ============================================================
# MeruVeda Frontend (Next.js) — Environment Variables Reference
# Copy this file to .env.local and fill in the real values.
# NEXT_PUBLIC_* variables are embedded in the client bundle —
# never put secrets in these variables.
# ============================================================

# Backend service origin (no trailing slash, no /api path) used by the
# /api/* rewrite in next.config.ts when NOT deployed on Vercel.
# Takes precedence over NEXT_PUBLIC_API_URL for the rewrite.
# Vercel: LEAVE UNSET — vercel.json's platform rewrite handles /api/*, and
# setting this makes next.config double-proxy every API call.
# Required in non-Vercel production builds - next.config.ts throws at
# build/startup if it (and NEXT_PUBLIC_API_URL) are both unset.
BACKEND_SERVICE_URL=

# Base URL of the backend API (no trailing slash)
# Dev:  http://localhost:5000/api
# Prod: https://api.meruveda.com/api  (or your backend Vercel URL)
# MUST be https in production — an http value makes the browser warn that
# submitted information is not secure.
# Also used as the rewrite fallback when BACKEND_SERVICE_URL is unset.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# URL of the admin dashboard — used for "Go to Admin" links
# Dev:  http://localhost:5174
# Prod: https://admin.meruveda.com
NEXT_PUBLIC_ADMIN_URL=http://localhost:5174

# WhatsApp OTP checkout flow. Default false = the no-OTP "Sign up" /
# quick-login flow is active. Set to true to bring the OTP UI back
# (backend must also have OTP_ENABLED=true for the OTP endpoints to respond).
NEXT_PUBLIC_OTP_ENABLED=false

# --- Analytics (all optional; leave unset and nothing third-party loads) ---
# Consent banner: GA4 and Meta Pixel load ONLY after the visitor accepts.
# Your choice is kept in localStorage under meruveda_consent.
# Vercel Web Analytics + Speed Insights are cookieless and need no id here —
# they are enabled per Vercel project in the dashboard.
#
# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX
#   - GA4 property -> Admin -> Data streams -> Measurement ID
#   - Also mark "purchase" as a key event there, or revenue shows up as
#     engagement only in reports.
NEXT_PUBLIC_GA_ID=

# Meta Pixel id, digits only, e.g. 123456789012345
#   - Meta Events Manager -> your Pixel -> Settings -> Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=

# NOTE: NEXT_PUBLIC_* values are baked in at BUILD time. Setting them requires a
# redeploy — editing the var without rebuilding changes nothing in the client
# bundle.
