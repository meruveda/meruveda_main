# ============================================================
# MeruVeda Frontend (Next.js) — Environment Variables Reference
# Copy this file to .env.local and fill in the real values.
# NEXT_PUBLIC_* variables are embedded in the client bundle —
# never put secrets in these variables.
# ============================================================

# Base URL of the backend API (no trailing slash)
# Dev:  http://localhost:5000/api
# Prod: https://api.meruveda.com/api  (or your backend Vercel URL)
# MUST be https in production — an http value makes the browser warn that
# submitted information is not secure.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# URL of the admin dashboard — used for "Go to Admin" links
# Dev:  http://localhost:5174
# Prod: https://admin.meruveda.com
NEXT_PUBLIC_ADMIN_URL=http://localhost:5174
