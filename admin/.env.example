# ============================================================
# MeruVeda Admin (Vite + React) — Environment Variables Reference
# Copy this file to .env.local and fill in the real values.
# VITE_* variables are embedded in the client bundle —
# never put secrets in these variables.
# ============================================================

# Base URL of the backend API (no trailing slash)
# Dev:  http://localhost:5000/api
# Prod: https://api.meruveda.com/api  (or your backend Vercel URL)
VITE_API_BASE_URL=http://localhost:5000/api

# URL of the customer-facing storefront — used for "View Store" links
# Dev:  http://localhost:3000
# Prod: https://meruveda.com
VITE_CUSTOMER_WEBSITE_URL=http://localhost:3000
