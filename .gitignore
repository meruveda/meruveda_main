# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js and vite
.next/
dist/
!shared/dist/
out/

# production
build/

# misc
.DS_Store
*.pem
uploads/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files — real secrets stay out; example/template files are tracked
.env*
!**/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# `tsc -b` emits the compiled vite.config next to the source (admin build)
admin/vite.config.js
admin/vite.config.d.ts
admin/vite.config.js.map
admin/vite.config.d.ts.map

# stray invoice PDFs rendered during manual testing — samples live in docs/samples/
/*.pdf

# agents
.agents/
backend/.cache/
backend/*.log

# dev scratch scripts + accidental CLI --help dumps
scratch*
backend/schema.json
backend/schema.ts

# Data snapshots from scripts/backup-data.js contain customer PII - never commit
backend/backups/
backend/scripts/tmp/
