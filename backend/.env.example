# ============================================================
# MeruVeda Backend — Environment Variables Reference
# Copy this file to .env and fill in the real values.
# Never commit .env to version control.
# ============================================================

# --- Supabase ---
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<your-supabase-service-role-key>

# --- Auth ---
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<min-32-char-random-secret>
JWT_EXPIRES_IN=30d

# --- Server ---
PORT=5000
NODE_ENV=development

# --- CORS ---
# Comma-separated list of allowed frontend origins (no trailing slash)
# Dev:  http://localhost:3000,http://localhost:5173,http://localhost:5174
# Prod: https://meruveda.com,https://admin.meruveda.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# --- Frontend base URL ---
# Used to construct payment gateway redirect URLs at runtime.
# Dev:  http://localhost:3000
# Prod: https://meruveda.com (MUST be https — PayU posts the browser back
# here; an http value triggers "not secure" warnings and broken redirects)
FRONTEND_URL=http://localhost:3000

# --- Shiprocket ---
SHIPROCKET_EMAIL=your-shiprocket-login-email
SHIPROCKET_PASSWORD=your-shiprocket-login-password
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_PICKUP_LOCATION=your-pickup-location-name
SHIPROCKET_PICKUP_PINCODE=000000
SHIPROCKET_CHANNEL_ID=
SHIPROCKET_WEBHOOK_TOKEN=your-shiprocket-webhook-token
# Set to "true" to enable test/sandbox mode behaviour
SHIPROCKET_TEST_MODE=false

# --- PayU Payment Gateway (not yet integrated — configure before going live) ---
# Obtain from https://onboarding.payu.in
PAYU_MERCHANT_KEY=your-payu-merchant-key
PAYU_SALT=your-payu-salt
# Sandbox: https://test.payu.in/_payment
# Production: https://secure.payu.in/_payment
PAYU_BASE_URL=https://test.payu.in/_payment
# Code derives the PayU endpoint from this flag: "test" | "live"
PAYU_MODE=test
# Note: PayU redirect URLs are constructed at runtime from FRONTEND_URL.
# Do NOT set PAYU_SUCCESS_URL / PAYU_FAILURE_URL directly here.

# --- Tax / invoicing ---
# GSTIN printed on invoices (15 chars)
GSTIN=08BFPPS7045C1Z4
# "true" when shipping charges are taxable for the configured GSTIN
SHIPPING_IS_TAXABLE=false

# --- Google Identity Toolkit (currently unused; no hardcoded fallback) ---
GOOGLE_IDENTITY_TOOLKIT_API_KEY=

# --- Resend Configuration ---
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=MeruVeda <no-reply@meruvedawellness.com>

# --- WhatsApp Cloud API (Meta) ---
# Meta App Dashboard > WhatsApp > API Setup
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Meta App Dashboard > WhatsApp > Configuration > Webhook > Verify token
# (any random string you choose — must match what you paste into Meta)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Graph API version used for calls (default v20.0)
WHATSAPP_GRAPH_API_VERSION=v20.0

# --- Notifications ---
# Store owner/admin WhatsApp number in international format without "+".
# Every order invoice is copied here. e.g. 919876543210
ADMIN_WHATSAPP_NUMBER=

# Absolute URL of this backend — used to build the Meta webhook callback URL
# AND the PayU surl/furl when set (preferred over the request host).
# e.g. https://your-backend.vercel.app (MUST be https in production)
BACKEND_URL=

# --- Scheduled jobs (7-day review request) ---
# Shared secret the cron scheduler sends as `Authorization: Bearer <secret>`.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

