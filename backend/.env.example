# ============================================================
# MeruVeda Backend — Environment Variables Reference
# Copy this file to .env and fill in the real values.
# Never commit .env to version control.
# ============================================================

# --- Supabase ---
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<your-supabase-service-role-key>

# --- Image proxy (/api/images/fetch) ---
# Optional extra hostname allowlist (comma-separated) BEYOND the exact host
# of SUPABASE_URL above — e.g. if product images ever move to another CDN
# that also appears in next.config images.remotePatterns. No wildcards are
# supported; every entry is matched exactly. If SUPABASE_URL is unset the
# proxy rejects everything unless this var lists a host (fail closed).
IMAGE_PROXY_EXTRA_HOSTS=

# --- Auth ---
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<min-32-char-random-secret>
JWT_EXPIRES_IN=30d

# --- Server ---
PORT=5000
NODE_ENV=development

# --- CORS ---
# Comma-separated list of allowed browser origins (trailing slashes are
# stripped, matching is case-insensitive). The server REFUSES TO START in
# production when this is empty. No Origin header (curl, webhooks, cron) is
# always allowed.
# Dev:  http://localhost:3000,http://localhost:5173,http://localhost:5174
#       (any other http://localhost:* / http://127.0.0.1:* is auto-allowed
#       when NODE_ENV != production)
# Prod: list your production storefront + admin domains, plus ANY Vercel
#       preview URL you want to test with — explicitly, one by one:
#       https://meruveda.com,https://admin.meruveda.com,https://meruveda-abc123.vercel.app
#       NEVER use a *.vercel.app wildcard in production.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Reverse-proxy hops in front of the API (Vercel edge = 1). Lets Express
# read the real client IP from X-Forwarded-For — the rate limiter keys on it.
TRUST_PROXY_HOPS=1

# --- Upstash Redis (serverless-safe shared store) ---
# Powers distributed rate limiting + cross-instance token caches. When unset
# in production a LOUD warning is logged and limits are per-instance only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Frontend base URL ---
# Used to construct payment gateway redirect URLs at runtime.
# Dev:  http://localhost:3000
# Prod: https://meruveda.com (MUST be https — PayU posts the browser back
# here; an http value triggers "not secure" warnings and broken redirects)
FRONTEND_URL=http://localhost:3000

# --- Shiprocket ---
SHIPROCKET_EMAIL=your-shiprocket-login-email
SHIPROCKET_PASSWORD=your-shiprocket-login-password
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_PICKUP_LOCATION=your-pickup-location-name
SHIPROCKET_PICKUP_PINCODE=000000
SHIPROCKET_CHANNEL_ID=
# Shared token checked (timing-safe) against the x-api-key header on
# POST /api/shiprocket/webhook. When unset, ALL webhooks are rejected 401.
SHIPROCKET_WEBHOOK_TOKEN=your-shiprocket-webhook-token
# Set to "true" to enable test/sandbox mode behaviour
SHIPROCKET_TEST_MODE=false

# --- PayU Payment Gateway (not yet integrated — configure before going live) ---
# Obtain from https://onboarding.payu.in
PAYU_MERCHANT_KEY=your-payu-merchant-key
PAYU_SALT=your-payu-salt
# Sandbox: https://test.payu.in/_payment
# Production: https://secure.payu.in/_payment
PAYU_BASE_URL=https://test.payu.in/_payment
# Code derives the PayU endpoint from this flag: "test" | "live"
PAYU_MODE=test
# Note: PayU redirect URLs are constructed at runtime from FRONTEND_URL.
# Do NOT set PAYU_SUCCESS_URL / PAYU_FAILURE_URL directly here.

# --- Tax / invoicing ---
# GSTIN printed on invoices (15 chars)
GSTIN=08BFPPS7045C1Z4
# "true" when shipping charges are taxable for the configured GSTIN
SHIPPING_IS_TAXABLE=false

# --- Business identity printed on the tax invoice (delta 010 feature) ---
# Multi-line address: use \n for line breaks. GSTIN falls back to GSTIN above.
BUSINESS_NAME=MeruVeda Wellness
BUSINESS_ADDRESS=Keharsh Enterprises (Sole Proprietorship)\nS/N. 12, Viru City Gym Road, Inside Jalori Gate,\nJodhpur - 342001, Rajasthan, India
BUSINESS_GSTIN=08BFPPS7045C1Z4

# --- Post-order automation ---
# INVOICE_AUTO_SEND is now ON BY DEFAULT. The flag only exists so you can pause
# invoice delivery during an incident: set it to the literal string "false" to
# disable. Anything else (including leaving it unset) means enabled.
#   -> the invoice is generated ONCE, stored in Supabase Storage, and sent by
#      email + WhatsApp after PayU success, and on COD order confirmation.
#      An atomic claim_invoice() guarantees exactly one invoice per order.
# SET THIS TO true ON RENDER so the behaviour is explicit.
INVOICE_AUTO_SEND=true
# SHIPROCKET_AUTO_PUSH=false -> postOrderConfirmed() becomes the single, awaited
#                           Shiprocket push point for COD and prepaid orders.
SHIPROCKET_AUTO_PUSH=false

# Private Supabase Storage bucket the invoice PDF is mirrored into.
# The PDF is written ONCE and never regenerated, so the object path is stored on
# orders.invoice_url and served from there. A 7-day signed URL is added to the
# email / WhatsApp message.
#
# The name here MUST match the bucket you actually created. The RLS migration
# (sql/migrations/2026-10-14_row_level_security.sql) creates a bucket literally
# named "invoice" (private), while the code default below is "invoices". Create
# the bucket under whichever name you set here, or set this to "invoice" to use
# the one the migration makes. A mismatch is NOT fatal: storage is simply skipped,
# orders.invoice_url stays NULL, and the invoice is re-rendered per download.
INVOICE_STORAGE_BUCKET=invoices
INVOICE_SIGNED_URL_EXPIRY_SECONDS=604800

# Currency prefix printed on the invoice. pdf-lib's standard fonts are WinAnsi
# only and cannot draw the rupee glyph (U+20B9), so we default to "Rs.".
# Set to an empty value to print bare numbers once an embeddable TTF is in use.
INVOICE_CURRENCY_SYMBOL=Rs.

# Daily retry sweep for failed invoices + failed Shiprocket pushes.
# (see crons in vercel.json -> /api/jobs/retry-failures)
# The existing CRON_SECRET above is reused for this endpoint.

# --- Google Identity Toolkit (currently unused; no hardcoded fallback) ---
GOOGLE_IDENTITY_TOOLKIT_API_KEY=

# --- Resend Configuration ---
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=MeruVeda <no-reply@meruvedawellness.com>

# --- WhatsApp Cloud API (Meta) ---
# Meta App Dashboard > WhatsApp > API Setup
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Meta App Dashboard > WhatsApp > Configuration > Webhook > Verify token
# (any random string you choose — must match what you paste into Meta)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Meta App Dashboard > Settings > Basic > App Secret. Required to verify the
# X-Hub-Signature-256 header on inbound webhook POSTs — production REJECTS
# unsigned webhooks (401) when this is missing.
WHATSAPP_APP_SECRET=
# Graph API version used for calls (default v20.0)
WHATSAPP_GRAPH_API_VERSION=v20.0

# --- Notifications ---
# Store owner/admin WhatsApp number in international format without "+".
# Every order invoice is copied here. e.g. 919876543210
ADMIN_WHATSAPP_NUMBER=

# Absolute URL of this backend — used to build the Meta webhook callback URL
# AND the PayU surl/furl when set (preferred over the request host).
# e.g. https://your-backend.vercel.app (MUST be https in production)
BACKEND_URL=

# --- Scheduled jobs (7-day review request) ---
# Shared secret the cron scheduler sends as `Authorization: Bearer <secret>`.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# --- Checkout auth mode ---
# false (default) = no-OTP "Sign up" quick-login flow on checkout.
# true           = WhatsApp OTP flow (requires WHATSAPP_* credentials above).
# Frontend also needs NEXT_PUBLIC_OTP_ENABLED=true to show the OTP UI.
OTP_ENABLED=false


# ============================================================================
# Running on Vercel — what to expect
# ============================================================================
#
# Env vars are injected at runtime (no .env file in production; dotenv is
# skipped when NODE_ENV=production). Set every var above on all THREE Vercel
# projects (frontend, backend, admin) if you want one place to change them.
#
# CRON
#   * The three schedules in vercel.json fire GETs against this backend:
#       /api/jobs/review-requests                (daily 10:00 UTC)
#       /api/orders/retry-shiprocket-failed      (daily 03:00 UTC)
#       /api/jobs/retry-failures                 (daily 03:30 UTC)
#   * Vercel attaches `Authorization: Bearer $CRON_SECRET` automatically when
#     CRON_SECRET is set on the project. The endpoints also accept ?secret=
#     for manual runs:  curl -H "Authorization: Bearer $CRON_SECRET" \
#       https://<backend>/api/jobs/review-requests
#   * All three are timing-safe compared and fall back to an admin JWT, so an
#     unset CRON_SECRET is fail-closed (the jobs 401 — see the boot-time
#     production audit in src/config/env.ts, which refuses to start instead).
#   * On the Hobby plan crons may only run once per day and Vercel picks the
#     hour; the schedules above are all daily so they are valid, but do not
#     assume minute-level precision.
#
# FUNCTION TIMEOUT
#   * Fluid compute defaults to a 300 s maximum duration, which is plenty for
#     these jobs. No maxDuration needs setting in vercel.json.
#
# DISK / IMAGE PROXY
#   * The filesystem is read-only except /tmp, and /tmp does not survive
#     between invocations. The image proxy resizes into os.tmpdir() and treats
#     a wiped cache as a miss (re-resize from source), so it is correct but
#     does less work per cold instance. Derivatives are also sent with
#     `Cache-Control: public, max-age=31536000, immutable`, so the CDN absorbs
#     repeat traffic regardless of the warm cache.
#   * Nothing else may write to disk in production.
#
# RATE LIMITING
#   * Set UPSTASH_REDIS_REST_URL/TOKEN on Vercel. Without them the limiter
#     falls back to in-process memory: limits reset on every cold start and are
#     not shared between concurrently-running instances (logged loudly at boot).
#

# ============================================================================
# Running on Render (the current production backend)
# ============================================================================
#
# WHAT TO SET
#   * Render Dashboard > your service > Environment. Add every var above; values
#     are NOT inherited from this file and there is no committed .env.
#   * INVOICE_AUTO_SEND=true is already the default in code. Set it explicitly
#     so the dashboard shows the intent, and so flipping it to "false" during an
#     incident is a one-field edit — it is read per dispatch, not cached at boot.
#   * Set INVOICE_STORAGE_BUCKET to the bucket you actually created in Supabase
#     (see the note above).
#   * BACKEND_URL=https://<service>.onrender.com — required, because PayU's
#     surl/furl are built from it. Without it they are derived from the inbound
#     request host, which works but breaks when the service is reached via proxy.
#
# INVOICE DISPATCH ON RENDER
#   * Invoice generation runs inside the PayU-success callback and the COD
#     confirmation path — i.e. during the customer's request. It is NOT a
#     background worker, so there is no worker service or queue to keep alive.
#   * A failed invoice never blocks the order: the order is already committed,
#     the error lands in orders.invoice_error, and the daily
#     /api/jobs/retry-failures sweep picks it up.
#   * Free instances idle and get recycled, which is safe here: nothing is kept
#     in process memory between requests, and invoice numbers are allocated in
#     Postgres, so a restart cannot reuse or skip one.
#   * Health check path: /health. PDF rendering takes a few hundred ms and fits
#     comfortably inside the default request timeout.
#
# SUPABASE
#   * The Supabase client is created per request, so no connection pool needs
#     warming. The service-role key is server-only — never expose it via a
#     NEXT_PUBLIC_ or VITE_ prefixed var.

