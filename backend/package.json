  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "build": "tsc && node scripts/copy-assets.cjs",
    "start": "node dist/server.js",
    "test": "node --test --require ts-node/register/transpile-only --require ./src/testEnvSetup.ts src/routes/imageRoutes.test.ts src/controllers/analyticsController.test.ts src/routes/jobRoutes.test.ts src/config/corsOrigins.test.ts src/middleware/rateLimit.test.ts src/services/invoiceNumber.test.ts src/services/invoiceTemplate.test.ts src/services/invoiceTemplateContract.test.ts src/services/orderService.test.ts src/services/payuService.test.ts src/services/otpService.test.ts src/services/addressService.test.ts src/utils/resetToken.test.ts src/utils/otpHash.test.ts src/config/envAliases.test.ts",
    "samples": "node --require ts-node/register/transpile-only --require ./src/testEnvSetup.ts src/scripts/generateInvoiceSamples.ts",
    "samples:order": "node --require ts-node/register/transpile-only --require ./src/testEnvSetup.ts src/scripts/renderRealOrderSample.ts",
    "invoice:audit-schema": "node --require ts-node/register/transpile-only --require ./src/testEnvSetup.ts src/scripts/auditSchema.ts",
    "invoice:trace": "node --require ts-node/register/transpile-only --require ./src/testEnvSetup.ts src/scripts/traceOrder.ts",
    "invoice:dump-text": "node --require ts-node/register/transpile-only --require ./src/testEnvSetup.ts src/scripts/dumpPdfText.ts",
    "invoice:diff-reference": "node --require ts-node/register/transpile-only --require ./src/testEnvSetup.ts src/scripts/diffReferenceInvoice.ts",
    "db:migrate": "node scripts/migrate.js",
    "db:migrate:dry": "node scripts/migrate.js --dry-run",
    "db:verify": "node scripts/verify-schema.js",
    "db:verify:all": "node scripts/verify-schema.js --all",
    "db:bundle": "node scripts/build-migration-bundle.js",
    "db:bundle:check": "node scripts/build-migration-bundle.js --check",
    "db:backup": "node scripts/backup-data.js",
    "db:verify:backup": "node scripts/verify-backup.js --latest",
    "db:restore": "node scripts/restore-data.js",
    "db:migrate:pending": "node scripts/migrate-pending.js",
    "wa:verify": "node scripts/verify-whatsapp.js",
    "wa:verify:send": "node scripts/verify-whatsapp.js --send",
    "otp:smoke": "node --require ts-node/register/transpile-only --require ./src/testEnvSetup.ts src/scripts/otpSmoke.ts",
    "preflight": "node scripts/preflight.js"
  },
  "keywords": [],
