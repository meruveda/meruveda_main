    "@types/pg": "^8.23.1",
    "@upstash/redis": "^1.39.0",
    "@vercel/functions": "^3.10.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "nodemailer": "^6.9.13",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "resend": "^6.18.0",
    "sharp": "^0.34.5"
  },
